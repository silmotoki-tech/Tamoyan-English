          "en": "to go",
          "ja": "持ち帰りで",
          "type": "phrase",
          "lineIds": [
            "ln_003",
            "ln_004"
          ],
          "note": "イギリスでは take away"
        },
        {
          "id": "w_006",
          "en": "Anything else?",
          "ja": "他には？",
          "type": "phrase",
          "lineIds": [
            "ln_005"
          ],
          "note": "2語だが必ず出てくる"
        },
        {
          "id": "w_007",
          "en": "That's all.",
          "ja": "以上です",
          "type": "phrase",
          "lineIds": [
            "ln_006"
          ],
          "note": "注文を締めるときの定型"
        },
        {
          "id": "w_008",
          "en": "That'll be 〜",
          "ja": "〜になります（金額）",
          "type": "phrase",
          "lineIds": [
            "ln_007"
          ],
          "note": "会計で必ず聞く"
        },
        {
          "id": "w_009",
          "en": "Here you go.",
          "ja": "はい、どうぞ",
          "type": "phrase",
          "lineIds": [
            "ln_008"
          ],
          "note": "物やお金を渡すとき"
        }
