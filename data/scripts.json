          "lineIds": [
            "ln_003"
          ],
          "note": "Do you 〜? への短い肯定"
        },
        {
          "id": "w_004",
          "en": "Right this way.",
          "ja": "こちらへどうぞ",
          "type": "phrase",
          "lineIds": [
            "ln_003"
          ],
          "note": "案内するときの定型"
        },
        {
          "id": "w_005",
          "en": "Could we 〜?",
          "ja": "〜してもよいですか",
          "type": "phrase",
          "lineIds": [
            "ln_004"
          ],
          "note": "Can we より柔らかい依頼"
        },
        {
          "id": "w_006",
          "en": "by the window",
