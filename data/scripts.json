    {
      "id": "tpc_mari_hotel",
      "title": "ホテルでチェックインする",
      "titleEn": "Checking In at a Hotel",
      "level": "A1",
      "tags": [
        "旅行",
        "ホテル"
      ],
      "audience": "mari",
      "myRole": "S2",
      "speakers": [
        {
          "id": "S1",
          "label": "Front Desk",
          "gender": "female"
        },
        {
          "id": "S2",
          "label": "You",
          "gender": "female"
        }
      ],
      "blocks": [],
      "lines": [
        {
          "id": "ln_001",
          "speakerId": "S1",
          "en": "Good evening. Checking in?",
          "ja": "こんばんは。チェックインですか？",
          "note": "Are you checking in? の省略。実際のフロントではこの短い形で聞かれることが多い。",
          "skip": false
        },
        {
          "id": "ln_002",
          "speakerId": "S2",
          "en": "Yes. I have a reservation.",
          "ja": "はい。予約しています。",
          "note": "I have a reservation. が言えれば話が進む。予約は reservation（英国では booking）。",
          "skip": false
        },
        {
          "id": "ln_003",
          "speakerId": "S1",
          "en": "Can I have your name, please?",
          "ja": "お名前をいただけますか？",
          "note": "May I have 〜 も同じ。name が聞こえたら名前を言えばよい。",
          "skip": false
        },
        {
          "id": "ln_004",
          "speakerId": "S2",
          "en": "It's Motoki. M-O-T-O-K-I.",
          "ja": "モトキです。M-O-T-O-K-I。",
          "note": "名前は必ず綴りを聞き返される。先に言ってしまうと速い。声に出して綴る練習は実用度が高い。",
          "skip": false
        },
        {
          "id": "ln_005",
          "speakerId": "S1",
          "en": "Thank you. May I see your passport?",
          "ja": "ありがとうございます。パスポートを拝見できますか？",
          "note": "May I see 〜? は「見せてください」の丁寧な形。",
          "skip": false
        },
        {
          "id": "ln_006",
          "speakerId": "S2",
          "en": "Sure. Here you go.",
          "ja": "はい、どうぞ。",
          "note": "物を渡すときは Here you go. の一言で足りる。",
          "skip": false
        },
        {
          "id": "ln_007",
          "speakerId": "S1",
          "en": "You're in room 305, on the third floor.",
          "ja": "305号室、3階です。",
          "note": "部屋番号は three oh five と読む。zero ではなく oh。",
          "skip": false
        },
        {
          "id": "ln_008",
          "speakerId": "S2",
          "en": "Thank you. What time is breakfast?",
          "ja": "ありがとう。朝食は何時からですか？",
          "note": "What time is 〜? は時間を聞く基本形。そのまま使い回せる。",
          "skip": false
        },
        {
          "id": "ln_009",
          "speakerId": "S1",
          "en": "From seven to ten, on the second floor.",
          "ja": "7時から10時まで、2階です。",
          "note": "from 〜 to 〜 で時間の範囲。数字だけ聞き取れれば足りる。",
          "skip": false
        },
        {
          "id": "ln_010",
          "speakerId": "S2",
          "en": "Great. Thank you very much.",
          "ja": "よかった。ありがとうございます。",
          "note": "Great. は「よかった」「助かります」の軽い相づち。締めに使える。",
          "skip": false
        }
      ],
      "words": [
        {
          "id": "w_001",
          "en": "Checking in?",
          "ja": "チェックインですか？",
          "type": "phrase",
          "lineIds": [
            "ln_001"
          ],
          "note": "フロントで最初に言われる"
        },
        {
