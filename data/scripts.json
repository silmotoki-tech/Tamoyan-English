        },
        {
          "id": "w_005",
          "en": "May I see 〜?",
          "ja": "〜を拝見できますか",
          "type": "phrase",
          "lineIds": [
            "ln_005"
          ],
          "note": "見せてほしいときの丁寧な形"
        },
        {
          "id": "w_006",
          "en": "passport",
