        {
          "id": "w_006",
          "en": "You're fine.",
          "ja": "問題ありません",
          "type": "phrase",
          "lineIds": [
            "ln_007"
          ],
          "note": ""
        },
        {
          "id": "w_007",
          "en": "aisle seat",
