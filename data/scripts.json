            "ln_008"
          ],
          "note": "時間を聞く基本形"
        },
        {
          "id": "w_011",
          "en": "breakfast",
          "ja": "朝食",
          "type": "word",
          "lineIds": [
            "ln_008"
          ],
          "note": ""
        },
        {
          "id": "w_012",
          "en": "from 〜 to 〜",
          "ja": "〜から〜まで",
          "type": "phrase",
          "lineIds": [
            "ln_009"
          ],
          "note": ""
        },
        {
          "id": "w_013",
          "en": "Great.",
          "ja": "よかった、助かります",
          "type": "phrase",
          "lineIds": [
            "ln_010"
          ],
          "note": "軽い相づち。締めにも使える"
        },
        {
          "id": "w_014",
          "en": "What time is 〜? に入るもの",
          "ja": "breakfast（朝食）/ checkout（チェックアウト）/ the last train（終電）/ the shuttle bus（送迎バス）",
          "type": "phrase",
          "lineIds": [
            "ln_008"
          ],
          "note": "型は同じで中身だけ差し替える。時間を聞くのはこれ一つで足りる"
        },
        {
          "id": "w_015",
          "en": "Where is 〜? に入るもの",
          "ja": "the elevator（エレベーター）/ the restaurant（レストラン）/ the front desk（フロント）/ my room（私の部屋）",
          "type": "phrase",
          "lineIds": [
            "ln_007"
          ],
          "note": "場所を聞く型。指をさして言えば通じる"
        },
        {
          "id": "w_016",
          "en": "ホテルで耳にする言葉",
          "ja": "key card（カードキー）/ elevator（エレベーター）/ floor（階）/ towel（タオル）/ blanket（毛布）",
          "type": "word",
          "lineIds": [
            "ln_007"
          ],
          "note": "今回の会話には出ないが、聞こえたら分かるようにしておく"
        }
      ],
