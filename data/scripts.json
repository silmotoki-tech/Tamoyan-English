      "blocks": [],
      "lines": [
        {
          "id": "ln_001",
          "speakerId": "S1",
          "en": "Hi there. Do you have a reservation?",
          "ja": "いらっしゃいませ。ご予約はございますか？",
          "note": "Hi there. は店員が使う軽い呼びかけ。Hi よりわずかに親しみがある。",
          "alt": [],
          "chunks": [
            "Hi there. Do you",
            "have a reservation?"
          ],
          "skip": false
        },
        {
          "id": "ln_002",
          "speakerId": "S2",
          "en": "No, we don't. Do you have a table for two?",
          "ja": "いいえ。2人の席はありますか？",
          "note": "a table for two が丸ごと使える形。人数だけ差し替えれば済む。",
          "alt": [],
          "chunks": [
            "No, we don't. Do you",
            "have a table",
            "for two?"
          ],
          "skip": false
        },
        {
          "id": "ln_003",
          "speakerId": "S1",
          "en": "We do. Right this way, please.",
          "ja": "ございます。こちらへどうぞ。",
          "note": "We do. は Do you 〜? への短い肯定。Yes より自然に響く。",
          "alt": [],
          "chunks": [
            "We do. Right this way, please."
          ],
          "skip": false
        },
        {
          "id": "ln_004",
          "speakerId": "S2",
          "en": "Thank you. Could we sit by the window?",
          "ja": "ありがとうございます。窓際に座れますか？",
          "note": "Could we 〜? は頼みごとの基本形。Can we より柔らかい。",
          "alt": [],
          "chunks": [
            "Thank you. Could we sit",
            "by the window?"
          ],
          "skip": false
        },
        {
          "id": "ln_005",
          "speakerId": "S1",
          "en": "Of course. Here are your menus.",
          "ja": "もちろんです。メニューをどうぞ。",
          "note": "Here are 〜 は複数のものを差し出すとき。1つなら Here is 〜。",
          "alt": [],
          "chunks": [
            "Of course. Here",
            "are your menus."
          ],
          "skip": false
        },
        {
          "id": "ln_006",
          "speakerId": "S2",
          "en": "Thanks. What do you recommend?",
          "ja": "ありがとう。おすすめは何ですか？",
          "note": "この一文だけで会話が続く。旅行中もっとも使い回しが効く質問。",
          "alt": [],
          "chunks": [
            "Thanks. What do you recommend?"
          ],
          "skip": false
        },
        {
          "id": "ln_007",
          "speakerId": "S1",
          "en": "The grilled salmon is very popular today.",
          "ja": "本日はグリルサーモンがとても人気です。",
          "note": "料理名は聞き取れなくてよい。popular が聞こえれば「おすすめ」と分かる。",
          "alt": [],
          "chunks": [
            "The grilled salmon is",
            "very popular today."
          ],
          "skip": false
        },
        {
          "id": "ln_008",
          "speakerId": "S2",
          "en": "That sounds good. I'll have that.",
          "ja": "いいですね。それにします。",
          "note": "That sounds good. と I'll have 〜 の2つで注文が成立する。最重要。",
          "alt": [],
          "chunks": [
            "That sounds good. I'll have that."
          ],
          "skip": false
        },
        {
          "id": "ln_009",
          "speakerId": "S1",
          "en": "Great. Anything to drink?",
          "ja": "承知しました。お飲み物はいかがですか？",
          "note": "Anything to drink? は Would you like anything to drink? の短縮。実際はこう言われる。",
          "alt": [],
          "chunks": [
            "Great. Anything",
            "to drink?"
          ],
          "skip": false
        },
        {
          "id": "ln_010",
          "speakerId": "S2",
          "en": "Just water, please.",
          "ja": "お水だけお願いします。",
          "note": "Just 〜, please. は「〜だけで」を丁寧に言う型。断りにも使える。",
          "alt": [],
          "chunks": [
            "Just water, please."
          ],
          "skip": false
        },
        {
          "id": "ln_011",
          "speakerId": "S1",
          "en": "Certainly. I'll be right back.",
          "ja": "かしこまりました。すぐに戻ります。",
          "note": "I'll be right back. は店員が離れるときの定型。聞けば「待てばいい」と分かる。",
          "alt": [],
          "chunks": [
            "Certainly. I'll be right back."
          ],
          "skip": false
        },
        {
          "id": "ln_012",
          "speakerId": "S2",
          "en": "Thanks. No rush.",
          "ja": "ありがとう。急がなくて大丈夫です。",
          "note": "No rush. は2語で「ゆっくりで大丈夫」。余裕のある印象を与える。",
          "alt": [],
          "chunks": [
            "Thanks. No rush."
          ],
          "skip": false
        }
