        },
        {
          "id": "w_007",
          "en": "Here are 〜",
          "ja": "〜をどうぞ",
          "type": "phrase",
          "lineIds": [
            "ln_005"
          ],
          "note": "1つなら Here is 〜"
        },
        {
          "id": "w_008",
          "en": "What do you recommend?",
          "ja": "おすすめは何ですか",
          "type": "phrase",
          "lineIds": [
            "ln_006"
          ],
          "note": "旅行中もっとも使い回しが効く質問"
        },
        {
          "id": "w_009",
          "en": "popular",
          "ja": "人気のある",
          "type": "word",
          "lineIds": [
            "ln_007"
          ],
          "note": ""
        },
        {
          "id": "w_010",
          "en": "That sounds good.",
          "ja": "いいですね",
          "type": "phrase",
          "lineIds": [
            "ln_008"
          ],
          "note": "提案を受けるときの万能句"
        },
        {
          "id": "w_011",
          "en": "I'll have 〜",
          "ja": "〜にします（注文する）",
          "type": "phrase",
          "lineIds": [
            "ln_008"
          ],
          "note": "注文の基本形。I want は避ける"
        },
        {
          "id": "w_012",
          "en": "Anything to drink?",
          "ja": "お飲み物はいかがですか",
          "type": "phrase",
          "lineIds": [
            "ln_009"
          ],
          "note": "実際はこの短縮形で言われる"
        },
        {
          "id": "w_013",
          "en": "Just 〜, please.",
          "ja": "〜だけお願いします",
          "type": "phrase",
          "lineIds": [
            "ln_010"
          ],
          "note": "やんわり断るときにも使える"
        },
        {
          "id": "w_014",
          "en": "Certainly.",
          "ja": "かしこまりました",
          "type": "phrase",
          "lineIds": [
            "ln_011"
          ],
          "note": "Of course より丁寧"
        },
        {
          "id": "w_015",
          "en": "I'll be right back.",
          "ja": "すぐ戻ります",
          "type": "phrase",
          "lineIds": [
            "ln_011"
          ],
          "note": "店員が離れるときの定型"
        },
        {
          "id": "w_016",
          "en": "No rush.",
          "ja": "急がなくて大丈夫です",
          "type": "phrase",
