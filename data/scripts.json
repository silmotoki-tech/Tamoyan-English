            "ln_005"
          ],
          "note": ""
        },
        {
          "id": "w_007",
          "en": "Here you go.",
          "ja": "はい、どうぞ",
          "type": "phrase",
          "lineIds": [
            "ln_006"
          ],
          "note": "物を渡すとき"
        },
        {
          "id": "w_008",
          "en": "room 305",
          "ja": "305号室",
          "type": "phrase",
          "lineIds": [
            "ln_007"
          ],
          "note": "three oh five と読む。zeroではなくoh"
        },
        {
          "id": "w_009",
          "en": "on the third floor",
          "ja": "3階に",
          "type": "phrase",
          "lineIds": [
