    {
      "id": "tpc_sample_simcard",
      "title": "空港でSIMカードを購入する",
      "titleEn": "Buying a SIM Card at the Airport",
      "level": "B1",
      "tags": [
        "旅行",
        "買い物",
        "空港"
      ],
      "audience": "both",
      "myRole": "S2",
      "speakers": [
