      "lines": [
        {
          "id": "ln_001",
          "speakerId": "S1",
          "en": "Good morning. May I see your passport, please?",
          "ja": "おはようございます。パスポートを拝見してもよろしいですか？",
          "note": "May I 〜 は Can I 〜 より丁寧。カウンター業務では定番。",
          "alt": [],
          "chunks": [
            "Good morning. May I",
            "see your passport, please?"
          ],
          "skip": false
        },
        {
          "id": "ln_002",
          "speakerId": "S2",
          "en": "Sure, here you go.",
          "ja": "はい、どうぞ。",
          "note": "Here you go. は物を手渡すときの定型。",
          "alt": [],
          "chunks": [
            "Sure, here you go."
          ],
          "skip": false
        },
        {
          "id": "ln_003",
          "speakerId": "S1",
          "en": "Thank you. Are you checking any bags today?",
          "ja": "ありがとうございます。本日、お預けの荷物はございますか？",
          "note": "check a bag = 荷物を預ける。",
          "alt": [],
          "chunks": [
            "Thank you. Are you",
            "checking any bags today?"
          ],
          "skip": false
        },
        {
          "id": "ln_004",
          "speakerId": "S2",
          "en": "Yes, just this one suitcase.",
          "ja": "はい、このスーツケース一つだけです。",
          "note": "just = only。会話では just のほうが自然で柔らかい。",
          "alt": [],
          "chunks": [
            "Yes, just this one suitcase."
          ],
          "skip": false
        },
        {
          "id": "ln_005",
          "speakerId": "S1",
          "en": "Could you place it on the scale for me?",
          "ja": "こちらの計りに載せていただけますか？",
          "note": "place = put のフォーマル版。",
          "alt": [],
          "chunks": [
            "Could you place it",
            "on the scale",
            "for me?"
          ],
          "skip": false
        },
        {
          "id": "ln_006",
          "speakerId": "S2",
          "en": "There you go. Is it under the weight limit?",
          "ja": "はい、載せました。重量制限は超えていませんか？",
          "note": "There you go. は動作を完了したときの「はい、どうぞ」。",
          "alt": [],
          "chunks": [
            "There you go. Is it",
            "under the weight limit?"
          ],
          "skip": false
        },
        {
          "id": "ln_007",
          "speakerId": "S1",
          "en": "It's twenty-two kilos, so you're fine. The limit is twenty-three.",
          "ja": "22キロですので大丈夫です。制限は23キロまでです。",
          "note": "you're fine = 問題ありません。",
          "alt": [],
          "chunks": [
            "It's twenty-two kilos,",
            "so you're fine. The",
            "limit is twenty-three."
          ],
          "skip": false
        },
        {
          "id": "ln_008",
          "speakerId": "S2",
          "en": "Great. Could I get an aisle seat if possible?",
          "ja": "よかった。できれば通路側の席をお願いできますか？",
          "note": "aisle seat = 通路側。if possible を添えると角が立たない。",
          "alt": [],
          "chunks": [
            "Great. Could I get",
            "an aisle seat",
            "if possible?"
          ],
          "skip": false
        },
        {
          "id": "ln_009",
          "speakerId": "S1",
          "en": "Let me check. I have one available near the front.",
          "ja": "確認いたします。前方に一席空きがございます。",
          "note": "Let me check. は「確認します」の最頻出フレーズ。",
          "alt": [],
          "chunks": [
            "Let me check. I",
            "have one available",
            "near the front."
          ],
          "skip": false
        },
        {
          "id": "ln_010",
          "speakerId": "S2",
          "en": "That would be perfect. Thank you so much.",
          "ja": "それで完璧です。本当にありがとうございます。",
          "note": "提案を受け入れるときの丁寧な言い方。",
          "alt": [],
          "chunks": [
            "That would be",
            "perfect. Thank you",
            "so much."
          ],
          "skip": false
        },
        {
          "id": "ln_011",
          "speakerId": "S1",
          "en": "Here's your boarding pass. Your gate is B12 and boarding starts at ten forty.",
          "ja": "こちらが搭乗券です。ゲートはB12、搭乗開始は10時40分です。",
          "note": "時刻は ten forty のように読む。",
          "alt": [],
          "chunks": [
            "Here's your boarding pass.",
            "Your gate is B12",
            "and boarding starts",
            "at ten forty."
          ],
          "skip": false
        },
        {
          "id": "ln_012",
          "speakerId": "S2",
          "en": "Got it. Thanks for your help. Have a good one.",
          "ja": "承知しました。ご対応ありがとうございます。良い一日を。",
          "note": "Have a good one. は Have a nice day. のカジュアル版。",
          "alt": [],
          "chunks": [
            "Got it. Thanks",
            "for your help. Have",
            "a good one."
          ],
          "skip": false
        }
      ],
