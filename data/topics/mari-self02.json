  "lines": [
    {
      "id": "ln_001",
      "speakerId": "S1",
      "en": "Do you live alone or with family?",
      "ja": "一人暮らしですか？それとも家族と住んでいますか？",
      "note": ""
    },
    {
      "id": "ln_002",
      "speakerId": "S2",
      "en": "I live with my husband.",
      "ja": "夫と二人で暮らしています。",
      "note": ""
    },
    {
      "id": "ln_003",
      "speakerId": "S2",
      "en": "We don't have children, but we do have a stuffed chicken named Mofu, and we like to joke that he's our child.",
      "ja": "子どもはいませんが、モフというニワトリのぬいぐるみがいて、うちの子だと冗談で言っています。",
      "note": ""
    },
    {
      "id": "ln_004",
      "speakerId": "S1",
      "en": "Who are you closest to in your family?",
      "ja": "家族の中で一番親しいのは誰ですか？",
      "note": ""
    },
    {
      "id": "ln_005",
      "speakerId": "S2",
      "en": "I'm closest to Mofu, our stuffed chicken.",
      "ja": "一番親しいのは、うちのぬいぐるみのニワトリ、モフです。",
      "note": ""
    },
    {
      "id": "ln_006",
      "speakerId": "S2",
      "en": "We also have three pet guinea pigs named Kin-chan, Bon-chan, and Momo-chan, so our home is always full of cute characters.",
      "ja": "あとはモルモットが3匹いて、キンちゃん、ボンちゃん、モモちゃんといいます。家はいつもかわいい子でいっぱいです。",
      "note": ""
    },
    {
      "id": "ln_007",
      "speakerId": "S1",
      "en": "What do you usually do with friends?",
      "ja": "友達とは普段どんなことをしますか？",
      "note": ""
    },
    {
      "id": "ln_008",
      "speakerId": "S2",
      "en": "I don't meet my friends very often. However, I stay in touch with them every day through LINE.",
      "ja": "友達とはあまり頻繁には会いません。でもLINEで毎日やり取りしています。",
      "note": ""
    }
  ],
